# Rosely H3 + ZiT — unified S3 + distinct Vast-safe credentials
# Recommended base image:
# vastai/pytorch:cuda-13.0.3-auto

SERVERLESS=true
MODEL_BUNDLE_MODE=split

PYWORKER_REPO=https://github.com/ai-chad/rosely-zit-minimax-h3-serverless.git
PYWORKER_REF=main
PROVISIONING_SCRIPT=https://raw.githubusercontent.com/ai-chad/rosely-zit-minimax-h3-serverless/main/provision.sh

# ============================================================
# UNIFIED AWS CREDENTIALS
# ============================================================
# These are intentionally NOT named AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY so stale Vast environment values cannot collide.
AWS_UNIFIED_ACCESS_KEY_ID=replace_me
AWS_UNIFIED_SECRET_ACCESS_KEY=replace_me
# AWS_UNIFIED_SESSION_TOKEN=only_if_temporary

# ============================================================
# ONE SHARED S3 BUCKET
# ============================================================
ROSELY_S3_BUCKET=rosely-infrastructure
ROSELY_S3_REGION=us-east-1
ROSELY_S3_ENDPOINT_URL=
ROSELY_PRESIGNED_URL_EXPIRES_SECONDS=3600

# ============================================================
# SPLIT-MODE MODEL OBJECTS INSIDE THE SAME BUCKET
# ============================================================
ROSELY_H3_MODEL_KEY=models/minimax-h3/10eros-beta5-5090/10eros-beta5-5090-comfyui.tar.zst
ROSELY_H3_MODEL_CHECKSUM_KEY=models/minimax-h3/10eros-beta5-5090/10eros-beta5-5090-comfyui.tar.zst.sha256
ROSELY_H3_EXPECTED_SHA256=dbecf6da69978835ef2be92efe1104a8c4ee904abe7ac35b8108bcba3835c006

ROSELY_ZIT_MODEL_KEY=serverless/zimage/zenith13/zenith13-mxfp8-full-detailer-seedvr2-v3.tar.zst
ROSELY_ZIT_EXPECTED_SHA256=cfbd87e06b3b570c40c1436bea5cb31c0b1c70b772254d13791162f41df64fb7
ROSELY_ZIT_EXPECTED_SIZE=16309405103

# Generated outputs stay separated by prefix but use the same bucket.
ROSELY_H3_OUTPUT_PREFIX=generated/minimax-h3
ROSELY_ZIT_OUTPUT_PREFIX=generated/zit-fallback

# Provisioning/runtime.
ROSELY_MODEL_DOWNLOAD_CONCURRENCY=16
ROSELY_MODEL_DOWNLOAD_CHUNK_MIB=64
MIN_FREE_DISK_GB=135
MIN_EXTRACT_FREE_GB=70
ROSELY_INSTALL_ZIT_OPTIONAL_NODES=true

GENERATION_TIMEOUT_SECONDS=3600
IMAGE_GENERATION_TIMEOUT_SECONDS=900
KEEP_LOCAL_OUTPUTS=false
MAX_INPUT_IMAGE_BYTES=31457280
FREE_ON_FAMILY_SWITCH=true
FAMILY_SWITCH_SETTLE_SECONDS=0.5
REJECT_IMAGE_WHILE_VIDEO_BUSY=true
COMFY_HEALTH_STALE_SECONDS=90
COMFY_BUSY_HEALTH_STALE_SECONDS=900
COMFY_PROBE_INTERVAL_SECONDS=10
COMFY_PROBE_TIMEOUT_SECONDS=2
ALLOW_RAW_ZIT_WORKFLOW_JSON=true
COMFYUI_ARGS=

# Optional combined-bundle migration later:
# MODEL_BUNDLE_MODE=combined
# ROSELY_COMBINED_MODEL_KEY=models/combined/h3-zit-5090/h3-zit-5090-comfyui.tar.zst
# ROSELY_COMBINED_MODEL_CHECKSUM_KEY=models/combined/h3-zit-5090/h3-zit-5090-comfyui.tar.zst.sha256
# ROSELY_COMBINED_EXPECTED_SHA256=<exact sha256>
