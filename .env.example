# Rosely H3 (10Eros-Max v1.0 / beta7_sulpher3) + ZiT (Zenith 13 v3)
# Direct per-file S3 manifests + staged fast-boot (ZiT live ~60-90s, H3 syncs in background)
# Recommended base image:
# vastai/pytorch:cuda-13.0.3-auto

SERVERLESS=true
MODEL_BUNDLE_MODE=direct

PYWORKER_REPO=https://github.com/ai-chad/rosely-zit-minimax-h3-serverless.git
PYWORKER_REF=main
PROVISIONING_SCRIPT=https://raw.githubusercontent.com/ai-chad/rosely-zit-minimax-h3-serverless/main/provision.sh

# ============================================================
# UNIFIED AWS CREDENTIALS
# ============================================================
# Intentionally NOT named AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY so
# stale Vast environment values cannot collide.
AWS_UNIFIED_ACCESS_KEY_ID=replace_me
AWS_UNIFIED_SECRET_ACCESS_KEY=replace_me
# AWS_UNIFIED_SESSION_TOKEN=only_if_temporary

# ============================================================
# ONE SHARED S3 BUCKET
# ============================================================
ROSELY_S3_BUCKET=rosely-infrastructure
ROSELY_S3_REGION=us-east-1
ROSELY_S3_ENDPOINT_URL=
ROSELY_PRESIGNED_URL_EXPIRES_SECONDS=3600

# ============================================================
# DIRECT PER-FILE S3 MANIFESTS (FASTEST + ZERO ARCHIVE OVERHEAD)
# ============================================================
ROSELY_H3_MODEL_NAME=10Eros_Max_8stepTurbo_v1.0_hybrid-int8_HQ.safetensors
ROSELY_H3_MODEL_KEY=models/minimax-h3/beta7_sulpher3/manifest.json
ROSELY_H3_MODEL_CHECKSUM_KEY=models/minimax-h3/beta7_sulpher3/manifest.json.sha256
ROSELY_H3_EXPECTED_SHA256=45ad09171573a127d7388e6ab22ed0852069bc1046d5931bb821579175b7d529

ROSELY_ZIT_MODEL_KEY=serverless/zimage/zenith13/zenith13-mxfp8-full-detailer-seedvr2-v3-direct/manifest.json
ROSELY_ZIT_MODEL_CHECKSUM_KEY=serverless/zimage/zenith13/zenith13-mxfp8-full-detailer-seedvr2-v3-direct/manifest.json.sha256
ROSELY_ZIT_EXPECTED_SHA256=14b308d29489719b09beeff9708e6961537319eadc02cdac4f94b68da47fd6d4

# Voice Avatar + Ditto TensorRT (Qwen3-ASR-0.6B + Chatterbox Turbo + Ditto + 28 built-in voices)
ROSELY_ENABLE_VOICE=true
ROSELY_VOICE_REPO=https://github.com/ai-chad/rosely-vast-voice-avatar.git
ROSELY_VOICE_REF=main
ROSELY_VOICE_MODEL_KEY=models/voice-avatar/rosely-voice-ditto-v1/manifest.json
ROSELY_VOICE_MODEL_CHECKSUM_KEY=models/voice-avatar/rosely-voice-ditto-v1/manifest.json.sha256
ROSELY_VOICE_EXPECTED_SHA256=334a6170d549cae722100b49cfdd716e0d59882d90fd6d68c9e59e22704e4421
ROSELY_VOICE_FILE_WORKERS=4
ROSELY_VOICE_VRAM_MODE=auto
ROSELY_LIVE_CALL_ENABLED=1
DITTO_SOURCE_CACHE_DISK_GB=10
ROSELY_WAIT_FOR_VOICE_DURING_PROVISION=false
REQUIRE_VOICE_FOR_HEALTH=false
VOICE_DOWNLOAD_WAIT_TIMEOUT_SECONDS=900

# Generated outputs stay separated by prefix in the shared bucket.
ROSELY_H3_OUTPUT_PREFIX=generated/minimax-h3
ROSELY_ZIT_OUTPUT_PREFIX=generated/zit-fallback

# Provisioning / fast-boot tuning.
ROSELY_MODEL_DOWNLOAD_CONCURRENCY=16
ROSELY_MODEL_DOWNLOAD_CHUNK_MIB=32
ROSELY_ZIT_FILE_WORKERS=4
ROSELY_H3_FILE_WORKERS=3
MIN_FREE_DISK_GB=85
ROSELY_INSTALL_ZIT_OPTIONAL_NODES=true
ROSELY_WAIT_FOR_H3_DURING_PROVISION=false
ROSELY_BENCHMARK_FAMILY=zit
REQUIRE_H3_FOR_HEALTH=false
H3_DOWNLOAD_WAIT_TIMEOUT_SECONDS=900

# Optional H3 sampler experimentation (leave unset to honor caller payload; default res_multistep):
# ROSELY_H3_DEFAULT_SAMPLER=res_multistep
# ROSELY_H3_FORCE_SAMPLER=lcm

GENERATION_TIMEOUT_SECONDS=3600
IMAGE_GENERATION_TIMEOUT_SECONDS=900
KEEP_LOCAL_OUTPUTS=false
MAX_INPUT_IMAGE_BYTES=31457280
FREE_ON_FAMILY_SWITCH=true
FAMILY_SWITCH_SETTLE_SECONDS=0.5
REJECT_IMAGE_WHILE_VIDEO_BUSY=true
COMFY_HEALTH_STALE_SECONDS=90
COMFY_BUSY_HEALTH_STALE_SECONDS=900
COMFY_PROBE_INTERVAL_SECONDS=10
COMFY_PROBE_TIMEOUT_SECONDS=2
ALLOW_RAW_ZIT_WORKFLOW_JSON=true
COMFYUI_ARGS=
