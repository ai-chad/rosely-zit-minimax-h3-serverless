# Vast Serverless
SERVERLESS=true
PYWORKER_REPO=https://github.com/robert2398/rosely-h3-zit-5090-serverless.git
PYWORKER_REF=main
PROVISIONING_SCRIPT=https://raw.githubusercontent.com/robert2398/rosely-h3-zit-5090-serverless/main/provision.sh

# AWS credentials used by boto3 for model downloads and H3 outputs.
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
# AWS_SESSION_TOKEN=only_if_temporary

# ============================================================
# MODEL BUNDLE MODE
# ============================================================
# split = deploy immediately using your two existing production artifacts.
# combined = use one merged tar.zst created by scripts/build_combined_bundle.sh.
MODEL_BUNDLE_MODE=split

# Preferred combined artifact (used when MODEL_BUNDLE_MODE=combined)
ROSELY_COMBINED_S3_BUCKET=rosely-infrastructure
ROSELY_COMBINED_S3_REGION=us-east-1
ROSELY_COMBINED_S3_MODEL_KEY=models/combined/h3-zit-5090/h3-zit-5090-comfyui.tar.zst
ROSELY_COMBINED_S3_CHECKSUM_KEY=models/combined/h3-zit-5090/h3-zit-5090-comfyui.tar.zst.sha256
# REQUIRED in combined mode. Paste the first field from the generated .sha256 file.
ROSELY_COMBINED_EXPECTED_SHA256=
ROSELY_COMBINED_S3_ENDPOINT_URL=

# Existing H3 artifact (split mode)
ROSELY_H3_S3_BUCKET=rosely-infrastructure
ROSELY_H3_S3_REGION=us-east-1
ROSELY_H3_S3_MODEL_KEY=models/minimax-h3/10eros-beta5-5090/10eros-beta5-5090-comfyui.tar.zst
ROSELY_H3_S3_CHECKSUM_KEY=models/minimax-h3/10eros-beta5-5090/10eros-beta5-5090-comfyui.tar.zst.sha256
ROSELY_H3_S3_ENDPOINT_URL=

# Existing ZiT artifact (split mode)
ROSELY_ZIT_MODEL_S3_BUCKET=rosely-infrastructure
ROSELY_ZIT_MODEL_S3_REGION=us-east-1
ROSELY_ZIT_MODEL_S3_KEY=serverless/zimage/zenith13/zenith13-mxfp8-full-detailer-seedvr2-v3.tar.zst
ROSELY_ZIT_MODEL_S3_ENDPOINT_URL=

# Optional legacy ZiT model credentials. Only used if standard AWS_* creds are absent.
# AWS_ZIT_IMAGE_MODEL_ACCESS_KEY_ID=
# AWS_ZIT_IMAGE_MODEL_SECRET_ACCESS_KEY=
# AWS_ZIT_IMAGE_MODEL_SESSION_TOKEN=

# Model download/runtime disk. 180-200 GB Vast disk is recommended.
ROSELY_MODEL_DOWNLOAD_CONCURRENCY=16
ROSELY_MODEL_DOWNLOAD_CHUNK_MIB=64
MIN_FREE_DISK_GB=135
MIN_EXTRACT_FREE_GB=70

# Optional current ZiT detailer/SeedVR2 custom-node stack.
# Base fallback workflows do NOT require it. Leave false unless your fallback
# workflow_json actually uses Impact Pack / SeedVR2 / VRGameDevGirl nodes.
ROSELY_INSTALL_ZIT_OPTIONAL_NODES=false

# ============================================================
# H3 VIDEO OUTPUT
# ============================================================
ROSELY_H3_OUTPUT_BUCKET=rosely-infrastructure
ROSELY_H3_OUTPUT_PREFIX=generated/minimax-h3
ROSELY_H3_PRESIGNED_URL_EXPIRES_SECONDS=3600

# ============================================================
# ZIT IMAGE FALLBACK OUTPUT
# ============================================================
ROSELY_ZIT_OUTPUT_BUCKET=rosely-infrastructure
ROSELY_ZIT_OUTPUT_PREFIX=generated/zit-fallback
ROSELY_ZIT_PRESIGNED_URL_EXPIRES_SECONDS=3600
ROSELY_ZIT_S3_REGION=us-east-1
ROSELY_ZIT_S3_ENDPOINT_URL=

# If image output uses separate credentials, set these. Otherwise standard AWS_*
# credentials above are used.
# ROSELY_ZIT_S3_ACCESS_KEY_ID=
# ROSELY_ZIT_S3_SECRET_ACCESS_KEY=
# ROSELY_ZIT_S3_SESSION_TOKEN=

# Legacy image-output aliases are also accepted for migration:
# AWS_ZIT_IMAGE_ACCESS_KEY_ID=
# AWS_ZIT_IMAGE_SECRET_ACCESS_KEY=
# AWS_ZIT_IMAGE_S3_BUCKET_NAME=
# AWS_ZIT_IMAGE_S3_REGION=us-east-1
# AWS_ZIT_IMAGE_S3_ENDPOINT_URL=

# ============================================================
# RUNTIME
# ============================================================
GENERATION_TIMEOUT_SECONDS=3600
IMAGE_GENERATION_TIMEOUT_SECONDS=900
KEEP_LOCAL_OUTPUTS=false
MAX_INPUT_IMAGE_BYTES=31457280
LOG_LEVEL=INFO

# Explicit family switching: H3 -> ZiT or ZiT -> H3 asks ComfyUI to unload
# resident models before submitting the next family workflow.
FREE_ON_FAMILY_SWITCH=true
FAMILY_SWITCH_SETTLE_SECONDS=0.5

# Fallback image calls should fail fast while a video is actively using the 5090.
# Your backend can then keep/retry the primary image route instead of waiting.
REJECT_IMAGE_WHILE_VIDEO_BUSY=true

# Health remains valid longer while a real GPU job is running.
COMFY_HEALTH_STALE_SECONDS=90
COMFY_BUSY_HEALTH_STALE_SECONDS=900
COMFY_PROBE_INTERVAL_SECONDS=10
COMFY_PROBE_TIMEOUT_SECONDS=2

# Preserve compatibility with your current ZiT workflow_json caller.
ALLOW_RAW_ZIT_WORKFLOW_JSON=true

# Leave blank initially; ComfyUI smart memory management handles the 5090/32 GB.
COMFYUI_ARGS=
